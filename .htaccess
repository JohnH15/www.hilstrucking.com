# --- HILS: pages are UTF-8 (Cyrillic on /ru/ and /ua/) ---
AddDefaultCharset UTF-8

# --- HILS: one address, https://hilstrucking.com (no www, no http) ---
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hilstrucking.com%{REQUEST_URI} [L,R=301]

# --- HILS: hide service files from the web (FTP deploy still works) ---
<FilesMatch "^(\.gitignore|\.ftp-deploy-sync-state\.json|README\.md|CLAUDE\.md|config\.example\.php|error_log|.+\.gs|.+\.log)$">
  Require all denied
</FilesMatch>

# --- HILS: security headers ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
